# Server
# 5050 (not 5000) — macOS reserves 5000 for AirPlay Receiver.
PORT=5050
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/chat_app

# JWT
JWT_ACCESS_SECRET=super-secret-access-key-change-me
JWT_REFRESH_SECRET=super-secret-refresh-key-change-me
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d

# CORS (comma separated list, or * for all)
CORS_ORIGIN=*
